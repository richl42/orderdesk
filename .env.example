# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key, from console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# The password you type to log in, and a long random string used to sign the login cookie.
# Make a SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_PASSWORD=
SECRET_KEY=

# Where the database and client files live
DATA_DIR=data

# AI prices in pounds per million tokens, from Anthropic's current price list (used for cost logging)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# Name shown in the top bar
OPERATOR_NAME=Rich
