# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key, from console.anthropic.com
# (In a Claude Code cloud environment, set it as ORDERDESK_ANTHROPIC_API_KEY instead.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# The password you type to log in, and a long random string used to sign the login cookie.
# Make a SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_PASSWORD=
SECRET_KEY=

# Where the database and client files live. On a server, the persistent disk's folder, e.g. /var/data.
# (On Railway, a mounted volume is used automatically if DATA_DIR is not set.)
DATA_DIR=data

# Where backups made from the Home screen are kept. Defaults to backups/ on a laptop and
# <DATA_DIR>/backups on a server.
BACKUPS_DIR=

# Set to production on a server: the login cookie is HTTPS-only, and the app will not start with
# a short password, no SECRET_KEY, no DATA_DIR or AI_CACHE on.
APP_ENV=

# Largest upload allowed at once, in MB
MAX_UPLOAD_MB=25

# AI prices in pounds per million tokens, from Anthropic's current price list (used for cost logging)
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=

# Keep AI answers on disk and reuse them when exactly the same order is read again (on or off).
# The accuracy test always reuses them; in normal use leave this off.
AI_CACHE=off

# Name shown in the top bar
OPERATOR_NAME=Rich
